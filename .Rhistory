#
# Predicting HDI CATEGORY
# Use the category outcome instead of the index
model_columns <- c("HDI_Category", "InternetUsersPct")
train_filtered <- train_data %>% select(all_of(model_columns)) %>% drop_na()
test_filtered  <- test_data  %>% select(all_of(model_columns)) %>% drop_na()
long <- c("Low human development","Medium human development",
"High human development","Very high human development")
short <- c("Low","Medium","High","Very High")
train_filtered$HDI_Category <- factor(train_filtered$HDI_Category, levels = long, labels = short)
test_filtered$HDI_Category  <- factor(test_filtered$HDI_Category,  levels = long, labels = short)
set.seed(123)
# Recipe: category ~ InternetUsersPct
myrecipe <- recipe(HDI_Category ~ InternetUsersPct, data = train_filtered)
# Model: multinomial logistic regression
mymodel <- multinom_reg() %>%
set_engine("nnet") %>%
set_mode("classification")
myworkflow <- workflow() %>%
add_recipe(myrecipe) %>%
add_model(mymodel)
fitted_model <- fit(myworkflow, data = train_filtered)
# Predictions (class + probabilities)
predictions <- augment(fitted_model, new_data = test_filtered)
# Metric: accuracy (simple, minimal change)
accuracy(predictions, truth = HDI_Category, estimate = .pred_class)
# Visualize model performance
confusion_matrix <- table(Actual = predictions$HDI_Category,
Predicted = predictions$.pred_class)
print("Confusion Matrix:")
print(confusion_matrix)
# CAN WE IMPROVE ON THIS?
#
# Method 1:  Use an ordinal logistic model so that it knows the bins are ordered
# Recipe: ordinal outcome ~ InternetUsersPct
myrecipe <- recipe(HDI_Category ~ InternetUsersPct, data = train_filtered)
# Ordinal logistic (proportional odds) model
mymodel <- proportional_odds() %>%
set_engine("polr") %>%     # MASS::polr
set_mode("classification")
mymodel <- parsnip::proportional_odds() %>%
set_engine("polr") %>%     # MASS::polr
set_mode("classification")
levels_ord <- c("Low","Medium","High","Very High")
train_cls <- train_data[, c("HDI_Category","InternetUsersPct")]
test_cls  <- test_data[,  c("HDI_Category","InternetUsersPct")]
train_cls <- na.omit(train_cls); test_cls <- na.omit(test_cls)
train_cls$HDI_Category <- factor(train_cls$HDI_Category, levels = levels_ord, ordered = TRUE)
test_cls$HDI_Category  <- factor(test_cls$HDI_Category,  levels = levels_ord, ordered = TRUE)
# Fit ordinal logistic (proportional odds)
fit_polr <- polr(HDI_Category ~ InternetUsersPct, data = train_cls, Hess = TRUE)
library(MASS)
levels_ord <- c("Low","Medium","High","Very High")
train_cls <- train_data[, c("HDI_Category","InternetUsersPct")]
test_cls  <- test_data[,  c("HDI_Category","InternetUsersPct")]
train_cls <- na.omit(train_cls); test_cls <- na.omit(test_cls)
train_cls$HDI_Category <- factor(train_cls$HDI_Category, levels = levels_ord, ordered = TRUE)
test_cls$HDI_Category  <- factor(test_cls$HDI_Category,  levels = levels_ord, ordered = TRUE)
# Fit ordinal logistic (proportional odds)
fit_polr <- polr(HDI_Category ~ InternetUsersPct, data = train_cls, Hess = TRUE)
# CAN WE IMPROVE ON THIS?
#
# Method 1:  Use an ordinal logistic model so that it knows the bins are ordered
# # Ensure ordered outcome
# fit ordinal logistic
fit_polr <- polr(HDI_Category ~ InternetUsersPct, data = train_filtered, Hess = TRUE)
# predict on test
pred_class <- predict(fit_polr, newdata = test_filtered, type = "class")
pred_prob  <- predict(fit_polr, newdata = test_filtered, type = "probs")
# confusion matrix & accuracy
with(test_filtered, table(Actual = HDI_Category, Predicted = pred_class))
mean(pred_class == test_filtered$HDI_Category)
