# Heatmap of missingness for Liechtenstein (white=present, red=missing)
lie <- PreProcessingData[PreProcessingData$CountryCode == "LIE", , drop = FALSE]
lie <- lie[order(lie$year), , drop = FALSE]
yrs  <- lie$year
vars <- setdiff(names(lie), c("CountryCode", "year"))
z <- t(1L * is.na(lie[, vars, drop = FALSE]))
image(x = seq_along(yrs), y = seq_along(vars), z = z,
col = c("white", "red"), axes = FALSE,
xlab = "year", ylab = "variable", main = "LIE Missingness")
Heatmap of missingness for Liechtenstein (white=present, red=missing)
# Heatmap of missingness for Liechtenstein (white=present, red=missing)
code <- "LIE"
missing_heatmap_data <- PreProcessingData %>%
dplyr::filter(CountryCode == code) %>%
dplyr::group_by(year) %>%
dplyr::summarize(
dplyr::across(
-c(year, CountryCode),                # exclude IDs
~ mean(is.na(.)) * 100,
.names = "{.col}"
),
.groups = "drop"
) %>%
tidyr::pivot_longer(-year, names_to = "variable", values_to = "pct_missing") %>%
dplyr::mutate(Status = ifelse(pct_missing > 0, "Missing", "Present"))
View(lie)
